DATABASE_URL=postgres://postgres:postgres@localhost:5432/streamflix
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
STREAMFLIX_URL=http://localhost:3000
MOCK_WEBHOOK_SECRET=mock-secret-dev
MOCK_PROVIDER_PORT=3001
MOCK_PROVIDER_URL=http://localhost:3001
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx
RAZORPAY_CHECKOUT_URL=xxxx

# Optional: webhook retry (M2) and reconciliation (M6). Defaults shown; 0 disables an interval.
# WEBHOOK_RETRY_INTERVAL_MS=30000
# WEBHOOK_MAX_ATTEMPTS=8
# WEBHOOK_RETRY_BASE_SECONDS=30
# WEBHOOK_RETRY_MAX_SECONDS=3600
# RECON_INTERVAL_MS=900000
# RECON_LOOKBACK_DAYS=7
# RECON_STUCK_REFUND_MINUTES=15
# RECON_GRACE_SECONDS=120
# SUB_RENEWAL_REMINDER_DAYS=7
# Minutes an unpaid renewal checkout blocks another Renew (one renewal at a time).
# RENEW_PENDING_MINUTES=30
# DEMO ONLY: every pass period lasts 5 minutes instead of its days, to show expiry live. Applies to existing passes too. Leave unset normally
# SUB_DURATION_MINUTES=5

# Optional: usage quotas (M5) for the AI summary feature, per UTC day. Defaults shown.
# QUOTA_AI_SUMMARY_USER=5
# QUOTA_AI_SUMMARY_SUBSCRIBER=20
# QUOTA_AI_SUMMARY_PER_SEAT=10
# AI_SUMMARY_DELAY_MS=300
# AI_SUMMARY_FAIL_RATE=0

# Optional: agent-approved purchases (M7). Defaults shown.
# AGENT_APPROVAL_TTL_SECONDS=300
# defaults to a key derived from JWT_SECRET
# AGENT_APPROVAL_SECRET=
# MERCHANT_ID=LEARNX
# password needed to approve above this
# AGENT_STEPUP_ABOVE_CENTS=3000
# purchase proposals per agent per day
# AGENT_PROPOSALS_PER_DAY=20
# AGENT_PROPOSAL_TTL_HOURS=24
# AGENT_UNPAID_MINUTES=30
# 0 = off
# AGENT_SWEEP_INTERVAL_MS=60000
# payment the assistant uses unless asked otherwise: razorpay | mock (default razorpay when test keys are set, else mock)
# AGENT_DEFAULT_PROVIDER=razorpay

# LEARNX Assistant (real AI agent on /agent). Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq model with tool calling:
# GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback when Groq is rate-limited or down (Google AI Studio key):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# which to try first: groq | gemini
# LLM_PROVIDER=groq
# Any other OpenAI-compatible API instead (e.g. Ollama http://localhost:11434/v1):
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# ASSISTANT_MESSAGES_PER_DAY=30
# reconciliation marks older PENDING orders EXPIRED; 0 = off
# ORDER_PENDING_EXPIRY_MINUTES=60
# How long a finished purchase card stays in the chat before it fades out (ms)
# ASSISTANT_CARD_DONE_MS=5000
# Days the admin assistant log (/admin/assistant) is kept; 0 keeps everything.
# ASSISTANT_LOG_DAYS=90
